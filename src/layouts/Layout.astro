---
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
import "../styles/global.css";
import SeoHead from '../components/SeoHead.astro';
import { withBase } from '../utils/withBase';
const {
  title,
  description = 'Portfolio Filipa Misiaka - Software Engineer: aplikacje webowe, mobilne i gry (React, Node.js, Unity, Unreal Engine).',
  noindex = false,
} = Astro.props;
const home = withBase('/');
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <SeoHead title={title} description={description} noindex={noindex} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://api.github.com" crossorigin />
    <!-- Devicons (technology icons, used only by the home page); pinned version + SRI -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.16.0/devicon.min.css"
      integrity="sha384-DjehTlU5SubGD1zUGe78SkwLgw+q2y9DXnmy3EaDbXA9nvFMPW3LP5verNrWr9rW"
      crossorigin="anonymous"
    />
  </head>
  <body class="min-h-screen relative overflow-x-hidden">
    <!-- Animated Background -->
    <div class="fixed inset-0 -z-10 bg-linear-to-br from-slate-950 via-slate-900 to-slate-950"></div>
    <div class="fixed inset-0 -z-10 bg-linear-to-tr from-purple-950/20 via-transparent to-cyan-950/20 animate-gradient"></div>

    <main id="main">
      <slot />
    </main>
  </body>
</html>

<style>
  @keyframes gradient {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.6; }
  }
  .animate-gradient {
    animation: gradient 15s ease-in-out infinite;
  }
</style>

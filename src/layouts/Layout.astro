---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  /** Language-neutral route, used for hreflang alternates. */
  path?: string;
  noindex?: boolean;
}
import "../styles/global.css";
import Background from '../components/Background.astro';
import ThemeScript from '../components/ThemeScript.astro';
import SeoHead from '../components/SeoHead.astro';
import { withBase } from '../utils/withBase';
const { title, lang = 'pl', path, noindex = false } = Astro.props;
const description = Astro.props.description ?? useTranslations(lang).meta.homeDescription;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <SeoHead title={title} description={description} lang={lang} path={path} noindex={noindex} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ThemeScript />

    <link rel="preconnect" href="https://api.github.com" crossorigin />
  </head>
  <body class="min-h-screen relative overflow-x-hidden">
    <Background />

    <slot name="nav" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

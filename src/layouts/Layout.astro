---
interface Props {
  title: string;
  description?: string;
}
import "../styles/global.css";
import { withBase } from '../utils/withBase';
const { title, description = 'Portfolio projektów GitHub - Filip Misiak' } = Astro.props;
const home = withBase('/');
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Devicons for technology icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
  </head>
  <body class="min-h-screen relative overflow-x-hidden">
    <!-- Animated Background -->
    <div class="fixed inset-0 -z-10 bg-linear-to-br from-slate-950 via-slate-900 to-slate-950"></div>
    <div class="fixed inset-0 -z-10 bg-linear-to-tr from-purple-950/20 via-transparent to-cyan-950/20 animate-gradient"></div>

    <main id="main">
      <slot />
    </main>
  </body>
</html>

<style>
  @keyframes gradient {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.6; }
  }
  .animate-gradient {
    animation: gradient 15s ease-in-out infinite;
  }
</style>

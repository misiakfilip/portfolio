---
// src/layouts/ProjectLayout.astro
import "../styles/global.css";
import SeoHead from '../components/SeoHead.astro';
import { withBase } from '../utils/withBase';
import Background from '../components/Background.astro';
import ThemeScript from '../components/ThemeScript.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { localizedPath, otherLang, useTranslations, type Lang } from '../i18n';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Language-neutral route, e.g. "/projects/Arct". */
  path: string;
  technologies?: string[];
  github?: string;
  demo?: string;
}

const { title, description, lang, path, technologies = [], github, demo } = Astro.props;
const dictionary = useTranslations(lang);
const t = dictionary.project;
const home = localizedPath(lang);
const other = otherLang(lang);
const fullTitle = `${title} - ${dictionary.meta.projectTitleSuffix}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <SeoHead title={fullTitle} description={description} lang={lang} path={path} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <ThemeScript />
  </head>
  <body class="min-h-screen relative overflow-x-hidden">
    <Background />

    <nav aria-label={dictionary.nav.label} class="fixed top-0 left-0 right-0 z-50 bg-card backdrop-blur-xl border-b border-line">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 md:py-4">
        <div class="flex items-center justify-between gap-3">
          <a href={home} class={`text-base sm:text-xl font-bold text-fg hover:text-accent transition-colors rounded`}>
            {t.backToPortfolio}
          </a>

          <div class="flex items-center gap-2 sm:gap-4">
            {github && (
              <a
                href={github}
                target="_blank"
                rel="noopener noreferrer"
                class={`px-3 sm:px-4 py-2 bg-card hover:bg-card-hover text-fg rounded-lg transition-colors backdrop-blur-md border border-line`}
              >
                {t.github}
              </a>
            )}
            {demo && (
              <a
                href={demo}
                target="_blank"
                rel="noopener noreferrer"
                class={`px-3 sm:px-4 py-2 bg-purple-700 hover:bg-purple-800 text-white rounded-lg transition-colors`}
              >
                {t.demo}
              </a>
            )}
            <ThemeToggle label={dictionary.nav.theme} />
            <a
              href={localizedPath(other, path)}
              hreflang={other}
              aria-label={dictionary.nav.switchLabel}
              class={`px-3 py-2 bg-purple-700 hover:bg-purple-800 text-white rounded-lg transition-colors font-medium`}
            >
              {dictionary.nav.switchShort}
            </a>
          </div>
        </div>
      </div>
    </nav>

    <main id="main" class="pt-28 md:pt-32 pb-20 px-6">
      <div class="max-w-5xl mx-auto">
        <header class="pb-12">
          <h1 class="text-3xl sm:text-4xl md:text-6xl font-bold text-fg mb-6 wrap-break-word">{title}</h1>
          <p class="text-lg sm:text-xl text-body mb-8">{description}</p>

          {technologies.length > 0 && (
            <ul class="flex flex-wrap gap-3 list-none">
              {technologies.map((tech) => (
                <li class="px-4 py-2 bg-chip border border-line text-chip-fg rounded-full text-sm font-medium backdrop-blur-sm">
                  {tech}
                </li>
              ))}
            </ul>
          )}
        </header>

        <slot />
      </div>
    </main>

    <footer class="py-8 border-t border-line bg-transparent backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-6 text-center text-muted">
        <a href={home} class={`text-accent-2 hover:underline transition-colors rounded`}>
          {t.backToHome}
        </a>
      </div>
    </footer>
  </body>
</html>

---
// Runs before the first paint (inline in <head>), so the page never flashes the wrong theme.
// Stored choice wins, otherwise the system preference; storage may throw (private mode), hence try/catch.
---

<script is:inline>
  (function () {
    var dark;
    try {
      var stored = localStorage.getItem('theme');
      dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    } catch (e) {
      dark = matchMedia('(prefers-color-scheme: dark)').matches;
    }
    document.documentElement.classList.toggle('dark', dark);
  })();
</script>

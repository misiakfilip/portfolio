---
import { Download, FileText, Code } from 'lucide-react';
import ProjectSection from './ProjectSection.astro';
import { withBase } from '../../utils/withBase';

interface Props {
  id?: string;
  title: string;
  downloads: Array<{ href: string; label: string; icon?: 'pdf' | 'file' | 'code'; size?: string }>;
}
const { id = 'downloads', title, downloads } = Astro.props;
const isExternal = (href: string) => /^[a-z][a-z0-9+.-]*:|^\/\//i.test(href);
---

{downloads.length > 0 && (
  <ProjectSection id={id} title={title}>
    <Download slot="icon" className="text-accent-2" size={28} aria-hidden="true" />
    <ul class="flex flex-col gap-4 list-none">
      {downloads.map(({ href, label, icon = 'file', size }) => {
        const Icon = icon === 'pdf' ? FileText : icon === 'code' ? Code : Download;
        return (
          <li>
            <a
              href={withBase(href)}
              download={isExternal(href) ? undefined : true}
              class="inline-flex items-center gap-3 px-6 py-3 bg-purple-700 hover:bg-purple-800 text-white rounded-lg transition-colors font-semibold shadow-lg hover:shadow-xl"
            >
              <Icon size={20} aria-hidden="true" />
              <span class="text-left">
                <span class="block">{label}</span>
                {size && <span class="block text-xs opacity-80">{size}</span>}
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </ProjectSection>
)}

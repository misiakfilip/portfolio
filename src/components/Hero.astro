---
import { Github, Linkedin, Mail, Download } from 'lucide-react';
import { useTranslations, type Lang } from '../i18n';
import { withBase } from '../utils/withBase';

interface Props {
  lang: Lang;
  name: string;
  title: string;
  bio: string;
  social: { github: string; linkedin: string; email: string };
  cvUrl?: string;
}

const { lang, name, title, bio, social, cvUrl } = Astro.props;
const t = useTranslations(lang).hero;
const iconLink =
  'text-gray-700 dark:text-gray-300 hover:text-purple-600 dark:hover:text-purple-400 transition-colors hover:scale-110 p-1 -m-1';
---

<section id="home" class="pt-28 md:pt-32 pb-20 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row items-center gap-12">
      <div class="flex-1 text-center md:text-left">
        <h1 class="text-4xl sm:text-5xl md:text-7xl font-bold text-gray-900 dark:text-white mb-6 wrap-break-word">
          {t.greeting}{' '}
          <span class="text-transparent bg-clip-text bg-linear-to-r from-purple-400 to-cyan-400">{name}</span>
        </h1>

        <p class="text-2xl md:text-3xl text-gray-700 dark:text-gray-300 mb-4 font-semibold">{title}</p>
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-8 max-w-2xl">{bio}</p>

        <div class="flex gap-4 justify-center md:justify-start flex-wrap mb-8">
          <a
            href={social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 bg-purple-700 hover:bg-purple-800 text-white rounded-lg flex items-center gap-2 transition-colors font-semibold shadow-lg hover:shadow-xl"
          >
            <Github size={20} aria-hidden="true" />
            {t.viewGitHub}
          </a>

          <a
            href={`mailto:${social.email}`}
            class="px-6 py-3 bg-gray-800 hover:bg-gray-700 text-white rounded-lg flex items-center gap-2 transition-colors font-semibold shadow-lg hover:shadow-xl"
          >
            <Mail size={20} aria-hidden="true" />
            {t.contact}
          </a>

          {/* TODO(owner): the button appears once config.cvUrl is set (upload public/cv.pdf). */}
          {cvUrl && (
            <a
              href={withBase(cvUrl)}
              download
              class="px-6 py-3 border-2 border-purple-600 text-purple-600 dark:text-purple-400 hover:bg-purple-50 dark:hover:bg-purple-900/20 rounded-lg flex items-center gap-2 transition-colors font-semibold"
            >
              <Download size={20} aria-hidden="true" />
              {t.downloadCV}
            </a>
          )}
        </div>

        <div class="flex gap-6 justify-center md:justify-start">
          <a href={social.github} target="_blank" rel="noopener noreferrer" class={iconLink} aria-label="GitHub">
            <Github size={28} aria-hidden="true" />
          </a>
          <a href={social.linkedin} target="_blank" rel="noopener noreferrer" class={iconLink} aria-label="LinkedIn">
            <Linkedin size={28} aria-hidden="true" />
          </a>
          <a href={`mailto:${social.email}`} class={iconLink} aria-label="Email">
            <Mail size={28} aria-hidden="true" />
          </a>
        </div>
      </div>

      {/* Self-hosted copy of the GitHub avatar: no third-party request, fixed size (no layout shift). */}
      <div class="shrink-0 relative">
        <div class="absolute inset-0 bg-purple-500 rounded-full blur-2xl opacity-20"></div>
        <img
          src={withBase('/avatar.webp')}
          alt={t.avatarAlt}
          width="320"
          height="320"
          fetchpriority="high"
          decoding="async"
          class="relative w-56 h-56 sm:w-64 sm:h-64 md:w-80 md:h-80 rounded-full border-4 border-purple-500 shadow-2xl object-cover"
        />
      </div>
    </div>
  </div>
</section>

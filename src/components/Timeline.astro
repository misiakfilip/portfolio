---
// Shared, responsive vertical timeline used by the experience (About) and Education sections.
import type { LucideIcon } from 'lucide-react';

interface TimelineItem {
  period: string;
  title: string;
  /** Company or school. */
  organization: string;
  organizationUrl?: string;
  description?: string;
  tags?: string[];
}

interface Props {
  id: string;
  title: string;
  subtitle: string;
  items: TimelineItem[];
  icon: LucideIcon; // rendered on the server only
}

const { id, title, subtitle, items, icon: Icon } = Astro.props;
---

<section id={id} class="py-20 px-6 scroll-mt-16">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-fg mb-4">{title}</h2>
      <p class="text-lg sm:text-xl text-muted">{subtitle}</p>
    </div>

    <div class="relative">
      <div aria-hidden="true" class="absolute left-3 md:left-1/2 top-0 bottom-0 w-0.5 -translate-x-1/2 bg-linear-to-b from-purple-500 via-cyan-400 to-transparent shadow-lg shadow-purple-500/50"></div>
      <ol class="list-none">
      {items.map((item, index) => (
        <li class={`relative flex flex-col md:flex-row gap-8 mb-12 last:mb-0 ${index % 2 === 0 ? 'md:flex-row-reverse' : ''}`}>
          <span aria-hidden="true" class="absolute left-3 md:left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-purple-600 border-4 border-white dark:border-slate-900 z-10"></span>

          <div class={`flex-1 min-w-0 ml-10 md:ml-0 ${index % 2 === 0 ? 'md:text-right md:pr-12' : 'md:pl-12'}`}>
            <div class="bg-card backdrop-blur-md rounded-xl p-5 sm:p-6 shadow-lg border border-line hover:shadow-2xl hover:shadow-cyan-500/20 transition-all duration-300 hover:-translate-y-1">
              <div class="inline-block px-4 py-1 bg-chip border border-line text-chip-fg rounded-full text-sm font-semibold mb-4">
                {item.period}
              </div>

              <h3 class={`text-xl sm:text-2xl font-bold text-fg mb-2 flex items-start gap-2 ${index % 2 === 0 ? 'md:justify-end' : ''}`}>
                <Icon size={24} aria-hidden="true" className="text-accent shrink-0 mt-0.5" />
                <span>{item.title}</span>
              </h3>
              <p class="text-lg text-accent font-semibold mb-3">
                {item.organizationUrl ? (
                  <a href={item.organizationUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">
                    {item.organization}
                  </a>
                ) : (
                  item.organization
                )}
              </p>

              {item.description && <p class="text-body mb-4 leading-relaxed">{item.description}</p>}

              {item.tags && item.tags.length > 0 && (
                <ul class={`flex flex-wrap gap-2 list-none ${index % 2 === 0 ? 'md:justify-end' : ''}`}>
                  {item.tags.map((tag) => (
                    <li class="px-3 py-1 bg-chip text-chip-fg rounded-full text-sm font-medium">{tag}</li>
                  ))}
                </ul>
              )}
            </div>
          </div>

          <div class="hidden md:block flex-1"></div>
        </li>
      ))}
      </ol>
    </div>
  </div>
</section>

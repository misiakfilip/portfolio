---
// Shared SEO tags for every page: canonical, Open Graph, Twitter Card, theme-color.
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<meta name="description" content={description} />
<meta name="theme-color" content="#0f172a" />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Filip Misiak" />
<meta property="og:locale" content="pl_PL" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<!-- TODO(owner): dodaj obraz 1200x630 (public/og.png) i og:image / twitter:image -->
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

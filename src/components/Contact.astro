---
import { Mail } from 'lucide-react';
import BrandIcon from './BrandIcon.astro';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  email: string;
  github: string;
  linkedin: string;
}

const { lang, email, github, linkedin } = Astro.props;
const t = useTranslations(lang).contact;
const round = 'flex items-center justify-center w-14 h-14 bg-card hover:bg-card-hover text-fg border border-line backdrop-blur-sm rounded-full transition-colors';
---

<section id="contact" class="py-20 px-6 relative border-t border-line scroll-mt-16">
  <div class="absolute inset-0 bg-linear-to-br from-purple-500/15 to-cyan-500/15"></div>
  <div class="relative max-w-4xl mx-auto text-center">
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-fg mb-6">{t.title}</h2>
    <p class="text-lg sm:text-xl text-body mb-12">{t.subtitle}</p>

    <a
      href={`mailto:${email}`}
      class="inline-flex items-center gap-3 px-8 py-4 bg-purple-700 hover:bg-purple-800 text-white text-lg font-semibold rounded-lg transition-colors shadow-xl hover:shadow-2xl"
    >
      <Mail size={24} aria-hidden="true" />
      {t.sendEmail}
    </a>

    <div class="flex items-center gap-4 my-12 max-w-md mx-auto">
      <div class="flex-1 h-px bg-line"></div>
      <span class="text-muted">{t.or}</span>
      <div class="flex-1 h-px bg-line"></div>
    </div>

    <p class="text-body mb-6 text-lg">{t.findMe}</p>
    <div class="flex gap-6 justify-center">
      <a href={github} target="_blank" rel="noopener noreferrer" class={round} aria-label="GitHub">
        <BrandIcon name="github" size={28} />
      </a>
      <a href={linkedin} target="_blank" rel="noopener noreferrer" class={round} aria-label="LinkedIn">
        <BrandIcon name="linkedin" size={28} />
      </a>
      <a href={`mailto:${email}`} class={round} aria-label="Email">
        <Mail size={28} aria-hidden="true" />
      </a>
    </div>
  </div>
</section>

---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/withBase';
---

<Layout title="404 - Nie znaleziono strony" description="Nie znaleziono strony. Wróć do portfolio Filipa Misiaka." noindex>
  <section class="min-h-screen flex flex-col items-center justify-center text-center px-6">
    <h1 class="text-6xl font-bold text-white mb-4">404</h1>
    <p class="text-xl text-gray-300 mb-8">Nie znaleziono strony / Page not found</p>
    <a href={withBase('/')} class="px-6 py-3 bg-purple-700 hover:bg-purple-800 text-white rounded-lg font-semibold transition-colors">
      Wróć do portfolio
    </a>
  </section>
</Layout>

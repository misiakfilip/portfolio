{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4399",
      "startServerReadyPattern": "4399",
      "startServerReadyTimeout": 60000,
      "numberOfRuns": 3,
      "url": [
        "http://localhost:4399/portfolio/", "http://localhost:4399/portfolio/projects/Arct/", "http://localhost:4399/portfolio/projects/brick-breaker/", "http://localhost:4399/portfolio/projects/skarbnik/",
        "http://localhost:4399/portfolio/en/", "http://localhost:4399/portfolio/en/projects/Arct/", "http://localhost:4399/portfolio/en/projects/brick-breaker/", "http://localhost:4399/portfolio/en/projects/skarbnik/"
      ],
      "settings": { "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "errors-in-console": ["error", { "minScore": 1 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 50000 }],
        "resource-summary:image:size": ["error", { "maxNumericValue": 250000 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "test-results/raporty/lhci" }
  }
}
